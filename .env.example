# Copia este archivo como .env y completa los valores. Nunca subas el .env
# al repositorio ni compartas los valores reales.
# Genera claves con:
#   DJANGO_SECRET_KEY:        python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   MIKROTIK_CREDENTIALS_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Django (obligatoria en producción; sin ella la app no arranca con DEBUG=false)
DJANGO_SECRET_KEY=
# false en producción. En desarrollo, 'true'.
DJANGO_DEBUG=false
# Dominios separados por comas, por ejemplo: api.midominio.com,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# Base de datos (por defecto SQLite en db.sqlite3). Para PostgreSQL:
# DJANGO_DATABASE_ENGINE=django.db.backends.postgresql
# DJANGO_DATABASE_NAME=mikrotik_admin
# DJANGO_DATABASE_USER=
# DJANGO_DATABASE_PASSWORD=
# DJANGO_DATABASE_HOST=127.0.0.1
# DJANGO_DATABASE_PORT=5432

# Cifrado de credenciales MikroTik guardadas (Router.password y
# ClientePPPoE.password_pppoe). Sin esta clave las contraseñas se guardan en
# texto plano. Si la cambias, las credenciales ya cifradas dejan de poder
# descifrarse: guárdala en un lugar seguro.
MIKROTIK_CREDENTIALS_KEY=

# Conexión RouterOS: API-SSL (puerto 8729) con verificación de certificado.
# Ponlas en 'false' solo con certificados autofirmados en laboratorio.
MIKROTIK_SSL_VERIFY=true
MIKROTIK_SSL_VERIFY_HOSTNAME=true
# Solo laboratorio: permite conexiones sin SSL (puerto 8728).
MIKROTIK_ALLOW_INSECURE_API=false

# Orígenes permitidos para CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
